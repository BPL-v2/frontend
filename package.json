{
  "name": "bpl2-frontend",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "serve": "vite preview",
    "build": "tsgo -b && vite build",
    "build-tsc": "tsc -b && vite build",
    "lint": "eslint .",
    "test": "vitest run",
    "format": "prettier --write src/",
    "preview": "vite preview",
