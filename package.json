    "dotenv": "^18.0.9",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "fallow": "^3.36.0",
    "globals": "^17.13.0",
    "npm-check-updates": "^23.1.1",
    "orval": "^8.45.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
